---
import Layout from '../layouts/Layout.astro';
import reviews from '../data/reviews.json';
---

<Layout title="Florian’s Reviews · Frontier Adventures Co.">
  <section class="pt-32 pb-12 px-6 md:px-12">
    <div class="max-w-4xl">
      <p class="text-gold uppercase tracking-widest text-xs mb-4 reveal">Public reviews</p>
      <h1 class="display text-5xl md:text-7xl leading-none reveal">Reviews</h1>
      <p class="mt-6 text-lg text-white/80 max-w-2xl reveal">
        Florian’s reviews from TripAdvisor and other platforms. Parks, hotels, and cruises.
      </p>
    </div>
  </section>

  <section class="pb-32 px-6 md:px-12">
    <div class="max-w-4xl mx-auto space-y-16">
      {reviews.map((r) => (
        <article class="reveal border-b border-white/10 pb-12">
          {r.image && (
            <img src={r.image} alt={r.title} class="w-full aspect-[16/9] object-cover mb-6" />
          )}
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="display text-3xl md:text-4xl">{r.title}</h2>
            <div class="text-gold">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</div>
          </div>
          <p class="mt-2 text-sm text-white/50">{r.platform} · {r.date}</p>
          <p class="mt-6 text-white/80 leading-relaxed whitespace-pre-line">{r.body}</p>
          {r.reply && (
            <blockquote class="mt-6 pl-4 border-l border-gold text-white/60 text-sm">
              {r.reply}
            </blockquote>
          )}
          <a href={r.url} class="inline-block mt-6 text-gold text-sm hover:underline" target="_blank" rel="noopener">Original review →</a>
        </article>
      ))}
    </div>
  </section>
</Layout>
