---
import PhotoCarousel from '../components/PhotoCarousel.astro';
import Layout from '../layouts/Layout.astro';
import reviews from '../data/reviews.json';
import { categories, destinationById } from '../lib/adventures';
import { href } from '../lib/paths';

// Accepts "YYYY-MM-DD" or "YYYY-MM"; anything else is shown as written
const formatDate = (value: string) => {
  const match = /^(\d{4})-(\d{2})(?:-(\d{2}))?$/.exec(value);
  if (!match) return { label: value, datetime: undefined };
  const [, year, month, day] = match;
  const date = new Date(Date.UTC(Number(year), Number(month) - 1, Number(day ?? 1)));
  if (Number.isNaN(date.getTime()) || date.getUTCMonth() !== Number(month) - 1) return { label: value, datetime: undefined };
  const label = date.toLocaleDateString('en-GB', {
    timeZone: 'UTC',
    year: 'numeric',
    month: 'long',
    ...(day ? { day: 'numeric' } : {}),
  });
  return { label, datetime: value };
};

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
const numeral = (i: number) => roman[i] ?? String(i + 1);

interface Review {
  id: string;
  title: string;
  platform: string;
  date: string;
  rating: number;
  images?: string[];
  body: string;
  summary?: string | null;
  sections?: { title: string; body: string }[];
  reply?: string | null;
  url: string;
  destination?: string | null;
  category?: string | null;
}

const entries = (reviews as unknown as Review[]).map((r, i) => {
  const [head, ...rest] = r.title.split(': ');
  const deck = rest.join(': ');
  const stars = Math.max(0, Math.min(5, Math.round(r.rating)));
  return {
    ...r,
    no: numeral(i),
    date: formatDate(r.date),
    // "Place: verdict" titles are set as a headline and a deck; the heading text itself is unchanged
    head,
    deck,
    stars,
    place: destinationById(r.destination),
    filedUnder: categories.find((c) => c.id === r.category)?.title,
    // Only our own photographs are shown. Remote third-party images in the data are skipped.
    photos: (r.images ?? []).filter((src) => !src.startsWith('http')),
    sections: r.sections ?? [],
  };
});

const numberWords = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const entryCount = `${numberWords[entries.length] ?? entries.length} ${entries.length === 1 ? 'entry' : 'entries'}`;

const star = 'M12 2.4l2.95 6.2 6.75.9-4.95 4.7 1.25 6.75L12 17.7l-6 3.25 1.25-6.75L2.3 9.5l6.75-.9z';
---

<Layout
  title="Reviews · Frontier Adventurers"
  description="Florian’s published reviews of parks, hotels and cruises, kept in full in the Frontier Adventurers expedition journal."
>
  <section class="journal-head surface-deep grain lantern" aria-labelledby="reviews-title">
    <div class="shell journal-head-grid">
      <div class="journal-title-block">
        <p class="eyebrow reveal">The expedition journal</p>
        <h1 id="reviews-title" class="display page-title text-parchment-light mt-5 reveal" style="--reveal-delay: 80ms">Reviews</h1>
      </div>

      <div class="journal-intro">
        <p class="lede reveal" style="--reveal-delay: 160ms">
          Florian’s reviews from TripAdvisor and other platforms: parks, hotels and cruises. The good, the less good, and the bits in between.
        </p>
        <p class="fell journal-count reveal" style="--reveal-delay: 240ms">
          {entryCount} in the journal so far.
        </p>
      </div>

      {entries.length > 1 && (
        <nav class="toc reveal" aria-label="Journal contents" style="--reveal-delay: 240ms">
          <p class="eyebrow no-rule">Contents</p>
          <ol class="toc-list">
            {entries.map((r) => (
              <li>
                <a href={`#${r.id}`} class="toc-link">
                  <span class="fell toc-no" aria-hidden="true">{r.no}.</span>
                  <span class="display toc-title">{r.head}</span>
                  <span class="fell toc-date">{r.date.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </section>

  <section class="journal surface-jungle grain" aria-label="Journal entries">
    <div class="journal-shell">
      {entries.map((r, i) => (
        <div class="sheet-stack">
          <article id={r.id} class="sheet surface-paper grain" aria-labelledby={`${r.id}-title`}>
            <header class="masthead">
              <div class="masthead-text">
                <p class="eyebrow reveal">Entry {r.no}{r.filedUnder && ` · ${r.filedUnder}`}</p>
                <h2 id={`${r.id}-title`} class="display entry-title reveal" style="--reveal-delay: 80ms">
                  {r.deck ? (
                    <>
                      <span class="entry-head">{r.head}<span class="sr-only">: </span></span>
                      <span class="entry-deck">{r.deck}</span>
                    </>
                  ) : r.title}
                </h2>
              </div>

              <p class="fell dateline reveal" style="--reveal-delay: 160ms">
                Published on {r.platform}, <time datetime={r.date.datetime}>{r.date.label}</time>. Written by Florian.
              </p>

              <div class="verdict">
                <div class="verdict-stamp">
                  <p class="verdict-label" aria-hidden="true">Rated</p>
                  <p class="display verdict-num" aria-hidden="true">{r.rating}<span>/5</span></p>
                  <div class="verdict-stars" role="img" aria-label={`${r.rating} out of 5 stars`}>
                    {[0, 1, 2, 3, 4].map((n) => (
                      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false" class={n < r.stars ? 'on' : 'off'}>
                        <path d={star} />
                      </svg>
                    ))}
                  </div>
                </div>
              </div>
            </header>

            <div class="rule-double masthead-rule" aria-hidden="true"></div>

            <div class="entry-body">
              {r.summary && (
                <div class="entry-row take">
                  <p class="margin-note eyebrow no-rule">Our take</p>
                  <p class="display take-text">{r.summary}</p>
                </div>
              )}

              {(r.place || r.filedUnder) && (
                <div class="entry-row particulars">
                  <p class="margin-note fell" aria-hidden="true">Particulars</p>
                  <dl class="particulars-list">
                    {r.place && (
                      <div>
                        <dt>Destination</dt>
                        <dd class="fell">{r.place.name}<span class="sr-only">, </span><span class="particulars-sub">{r.place.region}</span></dd>
                      </div>
                    )}
                    <div>
                      <dt>Platform</dt>
                      <dd class="fell">{r.platform}</dd>
                    </div>
                    {r.filedUnder && (
                      <div>
                        <dt>Filed under</dt>
                        <dd class="fell">{r.filedUnder}</dd>
                      </div>
                    )}
                  </dl>
                </div>
              )}

              {r.photos.length > 0 && (
                <div class="entry-row entry-photos">
                  <p class="margin-note fell" aria-hidden="true">Plates</p>
                  <PhotoCarousel
                    id={`review-photos-${r.id}`}
                    label={`Photos for ${r.title}`}
                    photos={r.photos.map((src, n) => ({ src, alt: `Photo ${n + 1} for the review: ${r.title}` }))}
                  />
                </div>
              )}

              {r.sections.length ? (
                r.sections.map((section, n) => (
                  <section class:list={['entry-row', 'entry-section', { 'is-first': n === 0 }]}>
                    <p class="margin-note fell section-no" aria-hidden="true">§ {numeral(n)}</p>
                    <div>
                      <h3 class="display section-title">{section.title}</h3>
                      <p class="entry-text">{section.body}</p>
                    </div>
                  </section>
                ))
              ) : (
                <div class="entry-row entry-section is-first">
                  <p class="margin-note fell section-no" aria-hidden="true">§</p>
                  <p class="entry-text">{r.body}</p>
                </div>
              )}

              {r.reply && (
                <div class="entry-row reply">
                  <p class="margin-note eyebrow no-rule">The reply</p>
                  <div><blockquote class="reply-text">{r.reply}</blockquote></div>
                </div>
              )}

              <footer class="entry-row entry-foot">
                <p class="margin-note fell folio" aria-hidden="true">Fol. {numeral(i)}</p>
                <div class="entry-foot-main">
                  <div class="ornament" aria-hidden="true"><span></span></div>
                  <p class="entry-foot-line">
                    <a href={r.url} class="link" target="_blank" rel="noopener">
                      Original review<span class="sr-only"> on {r.platform} (opens in a new tab)</span> <span aria-hidden="true">↗</span>
                    </a>
                    <span class="fell entry-sign" aria-hidden="true">End of entry {r.no}</span>
                  </p>
                </div>
              </footer>
            </div>
          </article>
        </div>
      ))}

      <div class="journal-close">
        <p class="fell journal-close-note reveal">That is every page written so far. The pen is capped, not retired.</p>
        <p class="journal-close-links reveal">
          <a href={href('food')} class="link">The food ledger <span class="arrow" aria-hidden="true">→</span></a>
          <a href={href('adventures')} class="link">See the adventures <span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Title page ---------- */
  .journal-head {
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vw, 5rem));
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }
  .journal-head-grid { display: grid; gap: 2.25rem; }
  .journal-head .lede { max-width: 34rem; }
  .journal-count {
    margin-top: 1.25rem;
    font-size: 1.15rem;
    color: rgb(232 211 165 / 0.78);
  }

  .toc { max-width: 44rem; }
  .toc-list { margin-top: 1rem; border-top: 1px solid rgb(196 154 80 / 0.32); }
  .toc-list li { border-bottom: 1px solid rgb(232 211 165 / 0.16); }
  .toc-link {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 0.5rem;
    min-height: 3rem;
    padding-block: 0.7rem;
    color: var(--parchment);
    transition: color 0.3s, padding-left 0.5s var(--ease-out);
  }
  .toc-link:hover { color: var(--gold-bright); padding-left: 0.5rem; }
  .toc-no { color: rgb(232 211 165 / 0.72); }
  .toc-title { font-size: 1.25rem; line-height: 1.2; }
  .toc-date { grid-column: 2; color: rgb(232 211 165 / 0.78); }

  @media (min-width: 640px) {
    .toc-link { grid-template-columns: 2.8rem minmax(0, 1fr) auto; column-gap: 1rem; }
    .toc-date { grid-column: 3; }
  }
  @media (min-width: 1024px) {
    .journal-head-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }
    .journal-title-block { grid-column: 1 / span 7; }
    .journal-intro { grid-column: 8 / span 5; padding-left: clamp(0.75rem, 2.4vw, 2.25rem); padding-bottom: 0.6rem; }
    .toc { grid-column: 1 / span 9; margin-top: 1.5rem; }
  }

  /* ---------- The wall and the pages ---------- */
  .journal { padding-bottom: clamp(4.5rem, 10vw, 8rem); }
  .journal-shell {
    width: 100%;
    max-width: 67rem;
    margin-inline: auto;
    padding-inline: 0.75rem;
  }

  /* Each entry is a page lying on the page beneath it. The first one overlaps the title page. */
  .sheet-stack {
    position: relative;
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  .sheet-stack:first-child { margin-top: clamp(-4.5rem, -6vw, -2.5rem); }
  /* The page beneath: offset a little, its foot cut slightly out of square */
  .sheet-stack::before {
    content: '';
    position: absolute;
    inset: 0 -0.35rem -0.75rem 0.35rem;
    background: color-mix(in srgb, var(--parchment-dark) 72%, var(--mahogany));
    clip-path: polygon(0 0, 100% 0.9rem, 100% calc(100% - 0.5rem), 0 100%);
  }
  .sheet {
    position: relative;
    padding: clamp(2rem, 6vw, 5rem) clamp(1.35rem, 6vw, 5.5rem) clamp(2.25rem, 5vw, 4rem);
    /* added to the page's scroll-padding, which already clears the fixed header */
    scroll-margin-top: 1.5rem;
  }

  /* ---------- Masthead ---------- */
  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1.25rem;
    row-gap: 1.1rem;
  }
  .masthead-text { grid-column: 1 / -1; }
  .entry-title {
    margin-top: 1.25rem;
    color: var(--mahogany);
    font-size: clamp(2.1rem, 1.3rem + 3.8vw, 4rem);
  }
  .entry-head { display: block; }
  .entry-deck {
    display: block;
    margin-top: 0.7rem;
    font-size: 0.5em;
    font-style: italic;
    font-weight: 440;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--mahogany-deep);
    max-width: 22em;
  }
  .entry-deck::first-letter { text-transform: uppercase; }
  .dateline {
    font-size: 1.15rem;
    line-height: 1.4;
    color: rgb(72 42 27 / 0.86);
  }

  /* Rating stamp, pressed on at a slight angle */
  .verdict { justify-self: end; margin: 0.4rem 0.4rem 0.4rem 0; }
  .verdict-stamp {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 0.65rem 0.9rem 0.7rem;
    border: 1.5px solid currentColor;
    outline: 1px solid currentColor;
    outline-offset: 3px;
    color: var(--mahogany);
    transform: rotate(-3.5deg);
  }
  .verdict-label {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    padding-left: 0.26em;
  }
  .verdict-num {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 2.6rem;
    line-height: 0.9;
  }
  .verdict-num span { font-size: 0.34em; font-style: italic; font-weight: 440; letter-spacing: 0.02em; }
  .verdict-stars { display: flex; gap: 0.18rem; margin-top: 0.15rem; }
  .verdict-stars svg { display: block; }
  .verdict-stars .on path { fill: currentColor; stroke: currentColor; stroke-width: 1.2; stroke-linejoin: round; }
  .verdict-stars .off path { fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; }

  .masthead-rule { margin-top: clamp(1.75rem, 4vw, 2.75rem); color: var(--mahogany); }

  /* ---------- Body: a margin for notes, a column for reading ---------- */
  .entry-body { margin-top: clamp(1.75rem, 4vw, 2.75rem); }
  .entry-row { display: grid; gap: 0.6rem; }
  .entry-row + .entry-row { margin-top: clamp(2rem, 4vw, 2.75rem); }

  .margin-note { color: rgb(72 42 27 / 0.86); font-size: 1.05rem; line-height: 1.3; }
  .margin-note.eyebrow { font-size: 0.7rem; color: var(--mahogany); }

  .take-text {
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 1.9rem);
    font-style: italic;
    font-weight: 440;
    line-height: 1.28;
    letter-spacing: -0.005em;
    color: var(--mahogany);
    text-wrap: pretty;
    max-width: 36rem;
  }

  .particulars-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.5rem, 5vw, 3.25rem);
    padding-block: 1.1rem;
    border-block: 1px solid rgb(72 42 27 / 0.28);
    max-width: 36rem;
  }
  .particulars-list dt {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(72 42 27 / 0.86);
  }
  .particulars-list dd { margin-top: 0.15rem; font-size: 1.15rem; line-height: 1.3; color: var(--mahogany-deep); }
  .particulars-sub { display: block; font-size: 0.98rem; color: rgb(72 42 27 / 0.86); }

  .entry-photos :global(photo-carousel) { max-width: 36rem; }

  .section-title {
    font-size: clamp(1.45rem, 1.2rem + 1vw, 1.85rem);
    line-height: 1.15;
    color: var(--mahogany);
  }
  .entry-text {
    margin-top: 0.85rem;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    white-space: pre-line;
    text-wrap: pretty;
    hanging-punctuation: first;
  }
  /* Drop cap on the opening paragraph */
  .is-first .entry-text::first-letter {
    float: left;
    margin: 0.09em 0.07em 0 -0.03em;
    font-family: 'Besley Variable', Besley, Georgia, serif;
    font-weight: 560;
    font-size: 3.75em;
    line-height: 0.78;
    color: var(--mahogany);
  }

  .reply-text {
    max-width: 36rem;
    padding-left: 1.25rem;
    border-left: 3px double rgb(72 42 27 / 0.55);
    font-style: italic;
    line-height: 1.7;
    white-space: pre-line;
    color: rgb(44 25 15 / 0.9);
  }

  .entry-foot { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .entry-foot-main { max-width: 36rem; }
  .entry-foot-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
  }
  /* 44px target, with the underline kept close to the words */
  .entry-foot-line .link { min-height: 2.75rem; align-items: flex-end; }
  .entry-sign { font-size: 1.05rem; color: rgb(72 42 27 / 0.86); }
  .folio { display: none; }

  /* Small screens: the section mark sits beside its heading instead of in a margin */
  @media (max-width: 859px) {
    .particulars > .margin-note,
    .entry-photos > .margin-note { display: none; }
    .section-no { font-size: 1rem; }
  }

  @media (min-width: 560px) {
    .journal-shell { padding-inline: 1.5rem; }
    .masthead { align-items: start; column-gap: 2rem; row-gap: 1.25rem; }
    .masthead-text { grid-column: 1; }
    .dateline { grid-column: 1; }
    .verdict { grid-column: 2; grid-row: 1 / span 2; margin: 0.5rem 0.35rem 0 0; }
    .verdict-stamp { padding: 0.8rem 1.15rem 0.85rem; gap: 0.3rem; }
    .verdict-num { font-size: 3.1rem; }
  }

  @media (min-width: 860px) {
    .journal-shell { padding-inline: 3rem; }
    .sheet-stack::before {
      inset: 0 -0.6rem -1rem 0.6rem;
      clip-path: polygon(0 0, 100% 1.4rem, 100% calc(100% - 0.7rem), -0.9rem 100%, -0.9rem calc(100% - 1.6rem), 0 calc(100% - 1.6rem));
    }
    .verdict-stamp { padding: 1rem 1.5rem 1.05rem; }
    .verdict-num { font-size: 3.8rem; }
    .verdict-stars svg { width: 16px; height: 16px; }

    .entry-body {
      --margin-col: clamp(7.5rem, 14vw, 11.5rem);
      position: relative;
    }
    /* The ruled margin line of a journal page */
    .entry-body::before {
      content: '';
      position: absolute;
      top: 0.25rem;
      bottom: 0;
      left: var(--margin-col);
      border-left: 1px solid rgb(72 42 27 / 0.3);
    }
    .entry-row {
      grid-template-columns: var(--margin-col) minmax(0, 1fr);
      gap: 0;
      align-items: baseline;
    }
    .entry-row > :last-child,
    .entry-photos :global(photo-carousel) { padding-left: clamp(1.5rem, 3.4vw, 3rem); }
    .entry-photos :global(photo-carousel) { max-width: calc(36rem + clamp(1.5rem, 3.4vw, 3rem)); }
    .margin-note { padding-right: 1.25rem; }
    .section-no { font-size: 1.2rem; }
    .entry-text { font-size: 1.125rem; }
    .is-first .entry-text::first-letter { font-size: 5.6em; margin-top: 0.07em; }
    .folio { display: block; align-self: end; padding-bottom: 0.7rem; }
    .entry-photos { align-items: start; }
    .entry-foot { align-items: start; }
  }

  /* ---------- Close ---------- */
  .journal-close { margin-top: clamp(4rem, 9vw, 6.5rem); padding-inline: 0.75rem; text-align: center; }
  .journal-close-note { font-size: 1.3rem; color: rgb(232 211 165 / 0.86); }
  .journal-close-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 2.5rem;
    margin-top: 1.75rem;
  }
  /* 44px target, with the underline kept close to the words */
  .journal-close-links .link { min-height: 2.75rem; align-items: flex-end; }
</style>
