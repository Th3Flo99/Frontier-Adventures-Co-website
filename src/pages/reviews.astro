---
import PhotoCarousel from '../components/PhotoCarousel.astro';
import Layout from '../layouts/Layout.astro';
import reviews from '../data/reviews.json';

// Accepts "YYYY-MM-DD" or "YYYY-MM"; anything else is shown as written
const formatDate = (value: string) => {
  const match = /^(\d{4})-(\d{2})(?:-(\d{2}))?$/.exec(value);
  if (!match) return { label: value, datetime: undefined };
  const [, year, month, day] = match;
  const date = new Date(Date.UTC(Number(year), Number(month) - 1, Number(day ?? 1)));
  if (Number.isNaN(date.getTime()) || date.getUTCMonth() !== Number(month) - 1) return { label: value, datetime: undefined };
  const label = date.toLocaleDateString('en-GB', {
    timeZone: 'UTC',
    year: 'numeric',
    month: 'long',
    ...(day ? { day: 'numeric' } : {}),
  });
  return { label, datetime: value };
};
---

<Layout title="Park, Hotel & Cruise Reviews · Frontier Adventures Co.">
  <section class="pt-32 pb-12 px-6 md:px-12">
    <div class="max-w-4xl mx-auto">
      <p class="text-gold uppercase tracking-widest text-xs mb-4 reveal">Public reviews</p>
      <h1 class="display text-5xl md:text-7xl leading-none reveal">Travel reviews</h1>
      <p class="mt-6 text-lg text-white/80 max-w-2xl reveal">
        Florian’s reviews from TripAdvisor and other platforms. Parks, hotels, and cruises.
      </p>
    </div>
  </section>

  <section class="pb-32 px-6 md:px-12">
    <div class="max-w-4xl mx-auto space-y-16">
      {reviews.map((r) => {
        const date = formatDate(r.date);
        return (
        <article class="reveal border-b border-white/10 pb-12">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="display text-3xl md:text-4xl">{r.title}</h2>
            <div class="text-gold" role="img" aria-label={`${r.rating} out of 5 stars`}>
              <span aria-hidden="true">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span>
            </div>
          </div>
          <p class="mt-2 text-sm text-white/60">{r.platform} · <time datetime={date.datetime}>{date.label}</time></p>

          {r.summary && (
            <div class="mt-6 p-6 bg-deep border-l-2 border-gold">
              <p class="text-gold text-xs uppercase tracking-widest mb-2">Our take</p>
              <p class="text-lg text-white/90 leading-relaxed">{r.summary}</p>
            </div>
          )}

          {r.images && r.images.length > 0 && (
            <div class="mt-6">
              <PhotoCarousel
                id={`review-photos-${r.id}`}
                label={`Photos for ${r.title}`}
                photos={r.images.map((src, n) => ({ src, alt: `Photo ${n + 1} for the review: ${r.title}` }))}
              />
            </div>
          )}

          {r.sections?.length ? (
            <div class="mt-8 space-y-8">
              {r.sections.map(section => (
                <section>
                  <h3 class="display text-2xl text-parchment">{section.title}</h3>
                  <p class="mt-3 text-white/80 leading-relaxed whitespace-pre-line">{section.body}</p>
                </section>
              ))}
            </div>
          ) : (
            <p class="mt-6 text-white/80 leading-relaxed whitespace-pre-line">{r.body}</p>
          )}
          {r.reply && (
            <blockquote class="mt-6 pl-4 border-l border-gold text-white/60 text-sm">
              {r.reply}
            </blockquote>
          )}
          <a href={r.url} class="inline-block mt-6 text-gold text-sm hover:underline" target="_blank" rel="noopener">Original review →</a>
        </article>
        );
      })}
    </div>
  </section>
</Layout>
