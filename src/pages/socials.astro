---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Socials · Frontier Adventures Co.">
  <section class="min-h-screen flex flex-col items-center justify-center px-6 py-32">
    <div class="text-center max-w-lg">
      <p class="text-gold uppercase tracking-widest text-xs mb-4 reveal">Link in bio</p>
      <h1 class="display text-5xl md:text-7xl leading-none reveal">The Frontier Adventures Co</h1>
      <p class="mt-6 text-white/70 reveal">Parks, cruises, food, and the occasional story.</p>
    </div>

    <div class="mt-16 w-full max-w-md space-y-4">
      <a href="https://www.instagram.com/the_frontier_adventures_co" target="_blank" rel="noopener" class="block reveal py-4 px-6 border border-white/20 hover:border-gold hover:text-gold text-center transition-colors">
        Instagram
      </a>
      <a href="https://www.youtube.com/@The_Frontier_Adventures_Co" target="_blank" rel="noopener" class="block reveal py-4 px-6 border border-white/20 hover:border-gold hover:text-gold text-center transition-colors">
        YouTube
      </a>
      <a href="https://www.tiktok.com/@thefrontieradventuresco" target="_blank" rel="noopener" class="block reveal py-4 px-6 border border-white/20 hover:border-gold hover:text-gold text-center transition-colors">
        TikTok
      </a>
      <a href="https://x.com/florianronsse" target="_blank" rel="noopener" class="block reveal py-4 px-6 border border-white/20 hover:border-gold hover:text-gold text-center transition-colors">
        X (personal)
      </a>
      <a href="https://linktr.ee/thefrontieradventuresco" target="_blank" rel="noopener" class="block reveal py-4 px-6 border border-white/20 hover:border-gold hover:text-gold text-center transition-colors">
        Linktree
      </a>
    </div>

    <p class="mt-16 text-xs text-white/40 reveal">Handles from Mira. X is currently Florian's personal; Stella is checking for a dedicated brand account.</p>
  </section>
</Layout>
