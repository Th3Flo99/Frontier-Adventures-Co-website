---
import Layout from '../layouts/Layout.astro';
import food from '../data/food.json';
---

<Layout title="Disney Food Reviews · Frontier Adventures Co.">
  <section class="pt-32 pb-12 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-4xl">
        <p class="text-gold uppercase tracking-widest text-xs mb-4 reveal">Megan’s domain</p>
        <h1 class="display text-5xl md:text-7xl leading-none reveal">Food</h1>
        <p class="mt-6 text-lg text-white/80 max-w-2xl reveal">
          Everything the group has eaten at Disney parks and on Disney Cruise Line. Scores are 1–5 from each person.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-8 px-6 md:px-12">
    <div class="max-w-6xl mx-auto flex flex-wrap gap-3 reveal" id="filters">
      <div class="flex flex-wrap gap-3" role="group" aria-label="Filter by type">
        <button type="button" data-filter="all" aria-pressed="true" class="filter-btn">All</button>
        <button type="button" data-filter="snack" aria-pressed="false" class="filter-btn">Snacks</button>
        <button type="button" data-filter="restaurant" aria-pressed="false" class="filter-btn">Restaurants</button>
      </div>
      <button type="button" data-sort="avg" aria-pressed="false" class="filter-btn">Highest score</button>
    </div>
    <p id="food-status" class="sr-only" aria-live="polite"></p>
  </section>

  <section class="pb-32 px-6 md:px-12">
    <div id="food-grid" class="max-w-6xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {food.map((item) => {
        const avg = Object.values(item.scores).reduce((a, b) => a + b, 0) / Object.values(item.scores).length;
        return (
          <article class="food-card group reveal border border-white/10 hover:border-gold/40 transition-colors" data-type={item.type} data-avg={avg.toFixed(1)}>
            <img src={item.image} alt={item.name} class="w-full aspect-[16/10] object-cover" />
            <div class="p-6">
              <div class="flex justify-between items-start gap-4">
                <h2 class="display text-2xl">{item.name}</h2>
                <span class="text-gold text-sm"><span class="sr-only">Average score </span>{avg.toFixed(1)}<span class="sr-only"> out of 5</span></span>
              </div>
              <p class="text-sm text-white/60 mt-1">{item.location}</p>
              <p class="mt-4 text-white/80 text-sm leading-relaxed">{item.review}</p>
              <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-white/60">
                {Object.entries(item.scores).map(([person, score]) => (
                  <span>{person} {score}/5</span>
                ))}
              </div>
              <p class="mt-3 text-xs text-white/60">{item.trip}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  .filter-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }
  .filter-btn:hover {
    border-color: var(--gold);
  }
  .filter-btn[aria-pressed='true'] {
    background-color: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }
</style>

<script>
  const grid = document.getElementById('food-grid');
  const status = document.getElementById('food-status');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.food-card'));
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const sortBtn = document.querySelector<HTMLButtonElement>('[data-sort]');

  const announce = () => {
    if (!status) return;
    const visible = cards.filter(c => c.style.display !== 'none').length;
    const sorted = sortBtn?.getAttribute('aria-pressed') === 'true';
    status.textContent = `Showing ${visible} of ${cards.length} items${sorted ? ', sorted by highest score' : ''}.`;
  };

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.filter;
      filterBtns.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach(card => {
        card.style.display = (type === 'all' || card.dataset.type === type) ? '' : 'none';
      });
      announce();
    });
  });

  // Toggle between highest score first and the original order
  sortBtn?.addEventListener('click', () => {
    const sortOn = sortBtn.getAttribute('aria-pressed') !== 'true';
    sortBtn.setAttribute('aria-pressed', String(sortOn));
    const ordered = sortOn
      ? [...cards].sort((a, b) => parseFloat(b.dataset.avg ?? '0') - parseFloat(a.dataset.avg ?? '0'))
      : cards;
    ordered.forEach(card => grid?.appendChild(card));
    announce();
  });
</script>
