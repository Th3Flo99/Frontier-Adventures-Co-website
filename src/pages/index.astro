---
import Layout from '../layouts/Layout.astro';
import LocalPhoto from '../components/LocalPhoto.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<Layout title="Frontier Adventures Co." description="Belgian friends exploring Disney parks and cruises together. Food, reviews, and stories.">
  <!-- Hero: photo on top with the text below by default. On wide landscape viewports (the
       "hero" screen in tailwind.config.mjs) the photo fills the right side and the text sits
       on the left, so the title never covers the group. -->
  <section class="relative flex flex-col hero:block hero:min-h-screen overflow-hidden">
    <div class="relative h-[56vh] min-h-[320px] overflow-hidden hero:absolute hero:inset-y-0 hero:right-0 hero:left-auto hero:w-[68%] hero:h-auto hero:min-h-0">
      <!-- "sizes" follows the cropped (object-cover) width, which is wider than the box itself.
           Side by side, the box is at least as tall as the text column, hence the 1100px floor. -->
      <LocalPhoto
        priority
        id="hero-img"
        src="group-photo.jpg"
        alt="The group in front of the castle"
        sizes="(min-width: 1024px) and (min-aspect-ratio: 5/4) max(140vh, 72vw, 1100px), (max-aspect-ratio: 3/4) 79vh, 105vw"
        class="w-full h-full object-cover object-center will-change-transform"
        style="transform: translateY(var(--parallax, 0px)) scale(1.05);"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent hero:via-transparent"></div>
      <div class="absolute inset-0 hidden hero:block bg-gradient-to-r from-ink via-ink/40 to-transparent to-45%"></div>
    </div>
    <!-- hero:pt-28 keeps the text clear of the fixed header when the viewport is short -->
    <div class="relative z-10 -mt-10 px-6 md:px-12 pb-20 hero:mt-0 hero:min-h-screen hero:flex hero:flex-col hero:justify-end hero:pt-28 hero:pb-28 hero:max-w-[44%]">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-6 reveal">Belgium · Disney · Together</p>
      <h1 class="display text-6xl md:text-8xl hero:text-7xl hero-xl:text-8xl leading-[0.9] text-white reveal">
        Frontier<br/>Adventures<br/>Co.
      </h1>
      <p class="mt-8 text-lg md:text-xl max-w-xl text-white/80 reveal">
        A small Belgian group that travels for the parks, the ships, and the food. We plan the days, eat everything worth eating, and write it down.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 reveal">
        <a href={`${base}food`} class="px-6 py-3 bg-gold text-ink font-medium hover:bg-white transition-colors">Explore food & snacks</a>
        <a href={`${base}reviews`} class="px-6 py-3 border border-white/40 text-white hover:border-gold hover:text-gold transition-colors">Read park, hotel & cruise reviews</a>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="py-24 md:py-32 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-12 gap-12 items-end mb-16">
        <h2 class="display text-4xl md:text-6xl md:col-span-7 reveal">Recent trips</h2>
        <p class="md:col-span-5 text-white/70 reveal">Short notes from the last few adventures. Full food and review logs live on their own pages.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <article class="group relative overflow-hidden reveal">
          <img loading="lazy" decoding="async" width="1000" height="750" src="https://images.unsplash.com/photo-1533929736458-ca588d08c8be?w=1000&q=80" alt="Cruise ship" class="w-full aspect-[4/3] object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/80 to-transparent"></div>
          <div class="absolute bottom-0 p-6">
            <p class="text-gold text-sm">Disney Cruise Line</p>
            <h3 class="display text-2xl mt-1">Fantasy Europe</h3>
          </div>
        </article>
        <article class="group relative overflow-hidden reveal">
          <LocalPhoto sizes="(min-width: 768px) 50vw, 100vw" src="group-photo.jpg" alt="Group at the castle" class="w-full aspect-[4/3] object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/80 to-transparent"></div>
          <div class="absolute bottom-0 p-6">
            <p class="text-gold text-sm">Disneyland Paris</p>
            <h3 class="display text-2xl mt-1">Together at the castle</h3>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Group teaser -->
  <section class="py-24 md:py-32 bg-deep px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <LocalPhoto src="group-photo.jpg" alt="Our friends together in front of the castle" sizes="(min-width: 768px) 50vw, 100vw" class="w-full aspect-[4/3] object-cover reveal" />
        <div class="reveal">
          <p class="text-gold uppercase tracking-widest text-xs mb-4">Five friends, shared adventures</p>
          <h2 class="display text-4xl md:text-5xl">Meet the group</h2>
          <p class="mt-6 text-white/80 leading-relaxed">We’re Florian, Megan, Elias, Lotte and Tibeau: Belgian friends with a shared love of Disney parks, cruises and a good meal along the way.</p>
          <a href={`${base}about`} class="inline-block mt-6 text-gold hover:underline">Get to know us →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA strip -->
  <section class="py-20 px-6 md:px-12 border-t border-white/10">
    <div class="max-w-4xl mx-auto text-center reveal">
      <p class="display text-3xl md:text-5xl">Follow the trips</p>
      <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3">
        <a href={`${base}socials`} class="text-gold hover:underline">Socials</a>
        <a href={`${base}food`} class="text-gold hover:underline">Food & snacks</a>
        <a href={`${base}reviews`} class="text-gold hover:underline">Parks, hotels & cruises</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Simple parallax on hero: one update per frame, only while the hero is on screen
  const heroImg = document.getElementById('hero-img');
  const hero = heroImg?.closest('section');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let ticking = false;

  const update = () => {
    ticking = false;
    if (!heroImg || !hero) return;
    const y = window.scrollY;
    if (reduceMotion.matches) {
      heroImg.style.setProperty('--parallax', '0px');
      return;
    }
    if (y > hero.offsetHeight) return;
    heroImg.style.setProperty('--parallax', `${y * 0.3}px`);
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });
  update();
</script>
