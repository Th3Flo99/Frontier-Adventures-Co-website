---
import Layout from '../layouts/Layout.astro';
import LocalPhoto from '../components/LocalPhoto.astro';
import Logo from '../components/Logo.astro';
import ExpeditionMap from '../components/ExpeditionMap.astro';
import CrewTeaser from '../components/CrewTeaser.astro';
import JournalTeaser from '../components/JournalTeaser.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
import site from '../data/site.json';
import { href } from '../lib/paths';
---

<Layout
  title="Frontier Adventurers · The World Is Our Next Adventure"
  description="Five Belgian friends. Endless adventures. Theme parks, Disney cruises, food reviews and honest travel stories from the Frontier Adventurers crew."
>
  <!-- Hero. Photo on top with the text below by default; on wide landscape viewports (the
       "hero" screen in tailwind.config.mjs) the photo fills the right side and the text sits
       on the left, so the headline never covers the crew. -->
  <section class="hero grain" aria-labelledby="hero-title">
    <div class="hero-photo" data-parallax-root>
      <!-- "sizes" follows the cropped (object-cover) width, which is wider than the box itself -->
      <LocalPhoto
        priority
        src="group-photo.jpg"
        alt="The five of us standing arm in arm in front of a castle"
        sizes="(min-width: 1024px) and (min-aspect-ratio: 5/4) max(150vh, 78vw, 1100px), (max-aspect-ratio: 3/4) 90vh, 115vw"
        class="hero-img"
      />
      <div class="hero-shade" aria-hidden="true"></div>
    </div>

    <!-- Title-card keyline, wide screens only -->
    <div class="hero-keyline" aria-hidden="true"></div>

    <div class="hero-copy">
      <div class="hero-logo hero-in" style="--d:0.1s"><Logo variant="hero" /></div>
      <p class="eyebrow hero-in" style="--d:0.25s">Belgium · Theme parks · Open sea</p>
      <h1 id="hero-title" class="display hero-title mt-5">
        <span class="hero-line"><span style="--d:0.35s">The World Is</span></span>
        <span class="hero-line"><span style="--d:0.47s">Our Next</span></span>
        <span class="hero-line"><span style="--d:0.59s">Adventure.</span></span>
      </h1>
      <p class="lede hero-lede hero-in" style="--d:0.85s">
        Five friends. Endless adventures. Join us as we explore extraordinary places, unforgettable experiences and a little magic along the way.
      </p>
      <div class="hero-actions hero-in" style="--d:1s">
        <a href={href('adventures')} class="btn btn-brass">Explore Our Adventures <span class="arrow" aria-hidden="true">→</span></a>
        <a href={href('about')} class="btn btn-ghost">Meet the Crew</a>
      </div>
    </div>

    <p class="hero-plate fell hero-in" style="--d:1.2s">Plate I. The whole crew, for once all looking at the camera.</p>

    <a href="#new-name" class="hero-scroll hero-in" style="--d:1.35s">
      <span>Begin the expedition</span>
      <span class="hero-scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- A new name, the same adventure -->
  <section id="new-name" class="surface-paper grain section" aria-labelledby="new-name-title">
    <div class="shell">
      <!-- Set like a notice pinned to the lodge board: the headline runs the full width, the
           note sits underneath to the right, the old name is stamped in the margin -->
      <p class="eyebrow reveal">A note from the crew</p>
      <h2 id="new-name-title" class="display notice-title mt-5 text-mahogany reveal">
        A New Name. <span class="notice-second">The Same Adventure.</span>
      </h2>
      <div class="rule-double mt-10 reveal" aria-hidden="true"></div>
      <div class="notice-body">
        <p class="lede notice-copy" data-ink-words>
          Formerly {site.formerName}, we’re entering a new chapter as {site.name}. Same crew, same passion, and many more adventures ahead.
        </p>
        <div class="notice-stamp reveal"><p class="stamp text-mahogany">Formerly {site.formerName}</p></div>
      </div>
    </div>
  </section>

  <ExpeditionMap />
  <CrewTeaser />
  <JournalTeaser />
  <VideoShowcase />
</Layout>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--jungle-deep);
  }
  .hero-photo {
    position: relative;
    height: 46vh;
    height: 46svh;
    min-height: 16rem;
    overflow: hidden;
  }
  /* Taller than its box so the parallax drift never shows an edge */
  .hero-photo :global(.hero-img) {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
    object-position: center;
    filter: sepia(0.16) saturate(0.9) contrast(1.04);
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(12 27 23 / 0.35), transparent 30%),
      linear-gradient(0deg, var(--jungle-deep) 2%, rgb(12 27 23 / 0.2) 42%, transparent 60%);
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    margin-top: -3.5rem;
    padding: 0 1.5rem 4.5rem;
  }
  .hero-title { font-size: clamp(2.5rem, 0.9rem + 7.6vw, 5.6rem); }
  .hero-lede { max-width: 34rem; margin-top: 1.25rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; margin-top: 1.6rem; }
  /* The header already carries the logo on small screens; the large lockup is for the title card */
  .hero-logo { display: none; }
  .hero-line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .hero-line > span {
    display: block;
    animation: hero-rise 1.1s var(--ease-out) both;
    animation-delay: var(--d, 0s);
  }
  .hero-in {
    animation: hero-fade 1.1s var(--ease-out) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes hero-rise {
    from { transform: translateY(105%); }
    to { transform: none; }
  }
  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  .hero-keyline,
  .hero-plate,
  .hero-scroll { display: none; }

  @media (min-width: 768px) {
    .hero-photo { height: 56vh; height: 56svh; min-height: 20rem; }
    .hero-copy { padding-inline: 3rem; }
    .hero-lede { margin-top: 1.75rem; }
    .hero-actions { margin-top: 2.25rem; }
  }

  /* A phone held sideways: photograph to the right, a compact title card to the left */
  @media (orientation: landscape) and (max-height: 500px) and (max-width: 1023.98px) {
    .hero { display: block; min-height: 100vh; min-height: 100svh; }
    .hero-photo { position: absolute; inset: 0 0 0 auto; width: 56%; height: auto; min-height: 0; }
    .hero-shade {
      background: linear-gradient(90deg, var(--jungle-deep) 0%, rgb(12 27 23 / 0.55) 22%, transparent 55%);
    }
    .hero-copy {
      max-width: 54%;
      margin-top: 0;
      padding: calc(var(--header-h) + 0.5rem) 0 1.75rem 1.5rem;
    }
    .hero-copy :global(.eyebrow) { display: none; }
    .hero-title { margin-top: 0; font-size: clamp(1.9rem, 10.5vh, 2.8rem); }
    .hero-lede { margin-top: 0.75rem; font-size: 0.98rem; line-height: 1.5; }
    .hero-actions { margin-top: 1rem; gap: 0.6rem; }
    .hero-actions :global(.btn) { min-height: 2.75rem; padding: 0.6rem 1.1rem; }
  }

  /* Wide landscape: photograph to the right, title card to the left */
  @media (min-width: 1024px) and (min-aspect-ratio: 5/4) {
    .hero { display: block; min-height: 100vh; min-height: 100svh; }
    .hero-photo {
      position: absolute;
      inset: 0 0 0 auto;
      width: 70%;
      height: auto;
      min-height: 0;
    }
    .hero-shade {
      background:
        linear-gradient(90deg, var(--jungle-deep) 0%, rgb(12 27 23 / 0.72) 18%, rgb(12 27 23 / 0.15) 48%, transparent 62%),
        linear-gradient(0deg, var(--jungle-deep) 0%, rgb(12 27 23 / 0.25) 22%, transparent 40%),
        radial-gradient(60% 55% at 78% 18%, rgb(221 185 111 / 0.14), transparent 70%);
    }
    .hero-copy {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 100vh;
      min-height: 100svh;
      max-width: 47%;
      margin-top: 0;
      padding: calc(var(--header-h) + 2.5rem) 0 6.5rem 3rem;
    }
    .hero-title { font-size: clamp(3.2rem, 5.6vw, 6.4rem); }
    .hero-lede { max-width: 29rem; margin-top: 1.75rem; }
    .hero-actions { margin-top: 2.25rem; }
    .hero-logo { display: block; margin-bottom: 2rem; }

    .hero-keyline {
      display: block;
      position: absolute;
      inset: calc(var(--header-h) + 0.5rem) 1.5rem 1.5rem;
      border: 1px solid rgb(196 154 80 / 0.38);
      pointer-events: none;
      z-index: 1;
      animation: hero-fade 1.6s var(--ease-out) 0.2s both;
    }
    .hero-plate {
      display: block;
      position: absolute;
      right: 3.25rem;
      bottom: 2.6rem;
      z-index: 2;
      max-width: 22rem;
      text-align: right;
      font-size: 1rem;
      color: rgb(232 211 165 / 0.82);
    }
    .hero-scroll {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      position: absolute;
      left: 3rem;
      bottom: 2.6rem;
      z-index: 2;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgb(232 211 165 / 0.75);
      transition: color 0.3s;
    }
    .hero-scroll:hover { color: var(--gold-bright); }
    .hero-scroll-line {
      position: relative;
      width: 4rem;
      height: 1px;
      background: rgb(232 211 165 / 0.3);
      overflow: hidden;
    }
    .hero-scroll-line::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--gold);
      /* A cue, not a fixture: it runs three times and then rests */
      animation: scroll-cue 2.6s var(--ease-out) 3 both;
    }
  }

  /* Short laptop screens: the title card has to fit in one screen, buttons and cue included.
     The header already shows the wordmark, so the large lockup steps aside. */
  @media (min-width: 1024px) and (min-aspect-ratio: 5/4) and (max-height: 860px) {
    .hero-logo { display: none; }
    .hero-copy { max-width: 50%; padding-bottom: 5.5rem; }
    .hero-title { font-size: clamp(2.6rem, min(5.4vw, 10vh), 6.4rem); }
    .hero-lede { max-width: 25rem; margin-top: 1.25rem; }
    .hero-actions { margin-top: 1.6rem; }
    .hero-actions :global(.btn) { padding-inline: 1.25rem; }
    .hero-shade {
      background:
        linear-gradient(90deg, var(--jungle-deep) 0%, rgb(12 27 23 / 0.82) 22%, rgb(12 27 23 / 0.2) 52%, transparent 66%),
        linear-gradient(0deg, var(--jungle-deep) 0%, rgb(12 27 23 / 0.25) 22%, transparent 40%);
    }
  }

  /* Narrower wide screens: keep the lede clear of the first crew member */
  @media (min-width: 1024px) and (max-width: 1199.98px) and (min-aspect-ratio: 5/4) {
    .hero-photo { width: 66%; }
    .hero-lede { max-width: 21.5rem; }
  }

  /* ---------- The rename notice ---------- */
  .notice-title { font-size: clamp(2.3rem, 1.2rem + 5vw, 5.6rem); max-width: 18ch; }
  .notice-second { display: block; }
  .notice-body { display: grid; gap: 2rem; margin-top: 2.5rem; }
  .notice-copy { max-width: 34rem; }
  @media (min-width: 1024px) {
    .notice-title { max-width: none; }
    .notice-body { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: 4rem; }
    .notice-copy { grid-column: 2; grid-row: 1; }
    .notice-stamp { grid-column: 1; grid-row: 1; padding-top: 0.5rem; }
  }
  @keyframes scroll-cue {
    0% { transform: translateX(-100%); }
    55%, 100% { transform: translateX(100%); }
  }
</style>
