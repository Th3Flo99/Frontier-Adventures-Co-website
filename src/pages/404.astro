---
import Layout from '../layouts/Layout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<Layout title="Page not found · Frontier Adventures Co." description="This page does not exist." noindex>
  <section class="min-h-screen flex flex-col items-center justify-center px-6 py-32 text-center">
    <p class="text-gold uppercase tracking-widest text-xs mb-4">Error 404</p>
    <h1 class="display text-5xl md:text-7xl leading-none">Lost in the park</h1>
    <p class="mt-6 text-lg text-white/80 max-w-md">
      This page does not exist, or it has moved. Let’s get you back to the group.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={base} class="px-6 py-3 bg-gold text-ink font-medium hover:bg-white transition-colors">Back to home</a>
      <a href={`${base}food`} class="px-6 py-3 border border-white/40 text-white hover:border-gold hover:text-gold transition-colors">Food & snacks</a>
      <a href={`${base}reviews`} class="px-6 py-3 border border-white/40 text-white hover:border-gold hover:text-gold transition-colors">Travel reviews</a>
    </div>
  </section>
</Layout>
