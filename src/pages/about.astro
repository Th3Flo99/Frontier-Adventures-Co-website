---
import LocalPhoto from '../components/LocalPhoto.astro';
import Layout from '../layouts/Layout.astro';
import group from '../data/group.json';
---

<Layout title="The Group · Frontier Adventures Co.">
  <section class="relative h-[60vh] md:h-[70vh] overflow-hidden">
    <LocalPhoto priority src="group-photo.jpg" alt="The group in front of the castle" class="w-full h-full object-cover object-center" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-transparent"></div>
  </section>

  <section class="pt-16 pb-24 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-4xl">
        <p class="text-gold uppercase tracking-widest text-xs mb-4 reveal">Who we are</p>
        <h1 class="display text-5xl md:text-7xl leading-none reveal">The group</h1>
        <p class="mt-6 text-lg text-white/80 max-w-2xl reveal">
          A Belgian friend group that keeps coming back to Disney parks and Disney Cruise Line. Florian plans everything, Megan owns the food, and the rest of us make sure the trips stay fun.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-32 px-6 md:px-12">
    <div class="max-w-6xl mx-auto space-y-32">
      {group.map((person, i) => (
        <article class="reveal">
          <div class={`grid md:grid-cols-2 gap-12 items-start ${i % 2 === 1 ? 'md:grid-flow-dense' : ''}`}>
            <div class={`min-w-0 ${i % 2 === 1 ? 'md:col-start-2' : ''}`}>
              {person.photos && person.photos.length > 0 ? (
                <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-thin">
                  {person.photos.map((photo, n) => (
                    <LocalPhoto
                      src={photo}
                      sizes="(min-width: 768px) 320px, 288px"
                      alt={`${person.name}, photo ${n + 1} of ${person.photos.length}`}
                      class="snap-start flex-shrink-0 w-72 md:w-80 aspect-[3/4] object-cover"
                    />
                  ))}
                </div>
              ) : (
                <LocalPhoto
                  src={person.image}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  alt={person.name}
                  class="w-full aspect-[4/5] object-cover"
                />
              )}
            </div>
            <div class={`min-w-0 ${i % 2 === 1 ? 'md:col-start-1 md:row-start-1' : ''}`}>
              <p class="text-gold text-sm uppercase tracking-widest">{person.role}</p>
              <h2 class="display text-4xl md:text-5xl mt-2">{person.name}</h2>
              <p class="mt-6 text-white/80 leading-relaxed">{person.bio}</p>
              {person.socials?.x && (
                <a href={person.socials.x} target="_blank" rel="noopener" class="inline-block mt-4 text-gold text-sm hover:underline">X →</a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="py-20 px-6 md:px-12 bg-deep border-t border-white/10">
    <div class="max-w-3xl mx-auto text-center reveal">
      <p class="display text-2xl md:text-3xl">More members later</p>
      <p class="mt-4 text-white/60">The list is open if someone new joins the trips.</p>
    </div>
  </section>
</Layout>
